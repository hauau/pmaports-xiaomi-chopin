pkgname=mesa-panfork-chopin
pkgver=23.0.0_git20240119
pkgrel=12
pkgdesc="Native Mali-G77 kbase graphics backend for Xiaomi chopin"
url="https://github.com/ROCKNIX/mesa-panfork"
arch="aarch64"
license="MIT AND SGI-B-2.0 AND BSL-1.0"
options="!check"
makedepends="
	bison
	expat-dev
	flex
	libdrm-dev
	libx11-dev
	libxdamage-dev
	libxext-dev
	libxfixes-dev
	libxrandr-dev
	libxshmfence-dev
	libxxf86vm-dev
	meson
	py3-mako
	py3-packaging
	py3-ply
	py3-yaml
	python3
	wayland-dev
	wayland-protocols
	xorgproto
	zlib-dev
	zstd-dev
	"
_commit=832c3c7117e4366e415ded92a6f07ec203fd9233
_prefix=/usr/lib/chopin-gpu
ldpath="$_prefix/lib"
sonameprefix="$pkgname:"
source="$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	0001-mali-g77-model.patch
	0002-python-version-check.patch
	0003-mediatek-jm-atom-layout.patch
	0004-valhall-jm-shader-state.patch
	0005-valhall-jm-tiler-state.patch
	0006-native-jm-completion.patch
	0007-jm-reserved-dependency-atom.patch
	0008-native-jm-bo-lifetime.patch
	0009-egl-dmabuf-export-failure.patch
	0010-native-jm-external-write-fences.patch
	0011-kbase-exportable-egl-images.patch
	0012-egl-surfaceless-primary-node.patch
	"
builddir="$srcdir/mesa-panfork-$_commit"

build() {
	# Keep the older kbase backend separate from the system Mesa installation.
	abuild-meson \
		--prefix="$_prefix" \
		--libdir=lib \
		--bindir=bin \
		--includedir=include \
		--datadir=share \
		--sysconfdir="$_prefix/etc" \
		--libexecdir=libexec \
		-Dgallium-drivers=kmsro,panfrost \
		-Dvulkan-drivers= \
		-Dplatforms=x11,wayland \
		-Degl=enabled \
		-Dgbm=enabled \
		-Dgles1=disabled \
		-Dgles2=enabled \
		-Dglx=dri \
		-Dglvnd=false \
		-Dllvm=disabled \
		-Dshared-glapi=enabled \
		-Dgallium-vdpau=disabled \
		-Dgallium-va=disabled \
		-Dgallium-xa=disabled \
		-Dgallium-opencl=disabled \
		-Dgallium-rusticl=false \
		-Dbuild-tests=false \
		-Dvalgrind=disabled \
		-Ddri-drivers-path="$_prefix/lib/dri" \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	rm -r "$pkgdir$_prefix/include" "$pkgdir$_prefix/lib/pkgconfig"
}


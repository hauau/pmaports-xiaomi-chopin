mtk-vcodec: decoder: drop vpud's stale view of MMAP bitstream buffers.

vpud reads each bitstream buffer through its own cacheable mapping to
parse slice headers. Clients fill MMAP buffers through an uncached
mapping, so when a buffer is reused vpud can still hit cache lines from
its previous contents. It then parses stale slice headers: intra frames
hardly change, but P and B frames are decoded against wrong references
and drift. The error disappeared whenever the input was throttled or the
caches were thrashed by other load.

Invalidate the CPU cache lines of MMAP bitstream buffers before they are
handed to vpud. No mapping writes them cached, so nothing dirty is lost.

--- a/drivers/media/platform/mtk-vcodec/mtk_vcodec_dec.c
+++ b/drivers/media/platform/mtk-vcodec/mtk_vcodec_dec.c
@@ -2071,6 +2071,32 @@
 			mtkbuf->frame_buffer.dma_general_buf,
 			(unsigned long)mtkbuf->frame_buffer.dma_general_addr);
 	}
+	/*
+	 * vpud parses the bitstream through its own cacheable mapping, while
+	 * MMAP buffers are filled through an uncached one. Drop the CPU cache
+	 * lines vpud may still hold from this buffer's previous contents, or
+	 * it parses stale slice headers and P/B frames are decoded against
+	 * wrong references. Nothing writes these buffers through a cached
+	 * mapping, so no dirty data is discarded.
+	 */
+	if (vb->vb2_queue->memory == VB2_MEMORY_MMAP &&
+		vb->vb2_queue->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE &&
+		vb->planes[0].dbuf && !(ctx->dec_params.svp_mode)) {
+		buf_att = dma_buf_attach(vb->planes[0].dbuf,
+			&ctx->dev->plat_dev->dev);
+		if (IS_ERR(buf_att))
+			return PTR_ERR(buf_att);
+		sgt = dma_buf_map_attachment(buf_att, DMA_FROM_DEVICE);
+		if (IS_ERR_OR_NULL(sgt)) {
+			dma_buf_detach(vb->planes[0].dbuf, buf_att);
+			return -EINVAL;
+		}
+		dma_sync_sg_for_device(&ctx->dev->plat_dev->dev, sgt->sgl,
+			sgt->orig_nents, DMA_FROM_DEVICE);
+		dma_buf_unmap_attachment(buf_att, sgt, DMA_FROM_DEVICE);
+		dma_buf_detach(vb->planes[0].dbuf, buf_att);
+	}
+
 	if (vb->vb2_queue->memory == VB2_MEMORY_DMABUF &&
 		!(mtkbuf->flags & NO_CAHCE_CLEAN) &&
 		!(ctx->dec_params.svp_mode)) {

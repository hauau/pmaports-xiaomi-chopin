# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/chopin_defconfig (lineage-23.2)
# This branch provides chopin_defconfig, not chopin_user_defconfig.
# UFS, ext4, NBD and USB configfs networking are built-in for USB netboot.
# Build: pmbootstrap build linux-xiaomi-chopin device-xiaomi-chopin
# TKPMIXM RAM boot crashes LK even with stock boot.img.
# Verified: full-size boot_a image with AVB footer, USB NBD rootfs and Nura/OpenRC.
# Keep pmos.debug-shell disabled for netboot: its USB rebind interrupts NBD.
maintainer="Sergei Shikalov <ssh@42px.org>"
pkgname=linux-xiaomi-chopin
pkgver=4.14.336
pkgrel=26
pkgdesc="Redmi Note 10 Pro 5G / POCO X3 GT downstream kernel"
arch="aarch64"
_carch="arm64"
_flavor="xiaomi-chopin"
_config="config-$_flavor.$arch"
url="https://github.com/xiaomi-mt6893-dev/kernel_xiaomi_mt6893"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native pmb:kconfigcheck-netboot"
makedepends="
	android-tools-mkdtboimg
	bash
	bc
	bison
	clang
	devicepkg-dev
	dtc
	elfutils-dev
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	perl
	python3
"
_commit="aeb1327b1c73dfe71c4d0e184e5c1c419ee7291f"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	$_config
	0001-arm64-vdso32-use-lld-for-LLVM-builds.patch
	use_system_dtc.patch
	0002-loop-rescan-after-block-size.patch
	0003-mediatek-allow-direct-firmware-loading.patch
	0004-chopin-native-panel-backlight.patch
	0005-vfs-faccessat2.patch
	0006-drm-generic-prime-import.patch
	0007-chopin-native-touch.patch
	0008-pidfd-waitid.patch
	0009-chopin-charge-controls.patch
	0010-chopin-native-bluetooth.patch
	0011-mali-native-gem-dma-buf.patch
	0012-drm-unprivileged-prime-sharing.patch
	0013-kcmp-independent-configuration.patch
	0014-chopin-bluetooth-reboot-close.patch
	0015-mali-native-implicit-dma-fences.patch
	0016-close-range-clamp-to-fdtable.patch
	0017-mtk-vcodec-dec-standard-clients.patch
	0018-mtk-vcodec-dec-mmap-capture.patch
	0019-mtk-vcodec-dec-displayed-buffer-ownership.patch
	0020-mtk-vcodec-dec-visible-rectangle.patch
	0021-mtk-vcodec-dec-mmap-bitstream-cache.patch
	0022-proc-pidns-owner-superblock.patch
	0023-mali-kbase-pid-namespaces.patch
"
builddir="$srcdir/kernel_xiaomi_mt6893-$_commit"
# Preserve CRLF in the vendor BTIF source instead of stripping patch CRs.
patch_args="-p1 --binary"
_outdir="out"

_make() {
	make O="$_outdir" ARCH="$_carch" CC=clang HOSTCC=clang \
		LLVM=1 LLVM_IAS=1 \
		CROSS_COMPILE=aarch64-alpine-linux-musl- \
		CROSS_COMPILE_ARM32=arm-linux-gnueabi- \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" "$@"
}

prepare() {
	default_prepare
	mkdir -p "$_outdir"
	cp "$srcdir/$_config" "$_outdir/.config"
	_make olddefconfig
}

build() {
	unset LDFLAGS
	_make Image.gz dtbs modules

	# Stock header v2 contains a DT table with one MT6893 base DTB.
	# Keep the existing device DTBO partition untouched during bring-up.
	mkdtboimg create "$_outdir/dtb.img" --page_size=2048 \
		"$_outdir/arch/$_carch/boot/dts/mediatek/mt6893.dtb"
}

package() {
	KERNEL_IMAGE_NAME=Image.gz downstreamkernel_package \
		"$builddir" "$pkgdir" "$_carch" "$_flavor" "$_outdir"
	install -Dm644 "$_outdir/dtb.img" \
		"$pkgdir/boot/dtbs/mediatek/mt6893-chopin-table.dtb"
	_make modules_install INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source
}

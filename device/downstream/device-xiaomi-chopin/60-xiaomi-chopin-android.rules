# SPDX-License-Identifier: MIT
# Device nodes of the unprivileged stock vendor daemons of Xiaomi chopin.
# vpud: video codec IPC (mtk-vcu) and its ION buffers.
KERNEL=="vcu", GROUP="xiaomi-chopin-vpud", MODE="0660"
KERNEL=="ion", GROUP="xiaomi-chopin-vpud", MODE="0660"
# mnld: GNSS data links and the GNSS EMI (ADC capture) device.
KERNEL=="gpsdl[01]", GROUP="xiaomi-chopin-gnss", MODE="0660"
KERNEL=="gps_emi", GROUP="xiaomi-chopin-gnss", MODE="0660"
# The read-only device-mapper views of the stock partitions and the APEX
# payloads the daemons loop-mount from them belong to the daemons alone; keep
# the desktop's automounting (udisks) from prompting for or mounting them.
# The loop backing path is reported relative to the daemon's private mount
# namespace, so match the APEX file name rather than its location.
SUBSYSTEM=="block", ENV{DM_NAME}=="xiaomi-chopin-stock-*", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", KERNEL=="loop*", ATTR{loop/backing_file}=="*/com.android.*.apex", ENV{UDISKS_IGNORE}="1"

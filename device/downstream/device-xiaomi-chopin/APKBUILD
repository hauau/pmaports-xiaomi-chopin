	60-xiaomi-chopin-android.rules
	90-xiaomi-chopin-gnss.conf
	"
options="!archcheck !check pmb:cross-native2"

build() {
	devicepkg_build $startdir $pkgname
	${CC:-gcc} $CFLAGS -Wall -Wextra -Werror -o xiaomi-chopin-wifi \
		"$srcdir/xiaomi-chopin-wifi.c" $LDFLAGS
	${CC:-gcc} $CFLAGS -Wall -Wextra -Werror -o xiaomi-chopin-charging \
		"$srcdir/xiaomi-chopin-charging.c" $LDFLAGS
	${CC:-gcc} $CFLAGS -Wall -Wextra -Werror -o xiaomi-chopin-sensors \
		"$srcdir/xiaomi-chopin-sensors.c" $LDFLAGS
	${CC:-gcc} $CFLAGS -Wall -Wextra -Werror -o xiaomi-chopin-android \
		"$srcdir/xiaomi-chopin-android.c" $LDFLAGS
	${CC:-gcc} $CFLAGS -Wall -Wextra -Werror -o xiaomi-chopin-gnss \
		"$srcdir/xiaomi-chopin-gnss.c" $LDFLAGS
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir/xiaomi-chopin-bootimg.sh" \
		"$pkgdir/usr/share/mkinitfs/xiaomi-chopin-bootimg.sh"
	install -Dm755 xiaomi-chopin-wifi "$pkgdir/usr/libexec/xiaomi-chopin-wifi"
	install -Dm755 "$srcdir/xiaomi-chopin-wifi.initd" \
		"$pkgdir/etc/init.d/xiaomi-chopin-wifi"
	install -Dm755 "$srcdir/xiaomi-chopin-bluetooth.initd" \
		"$pkgdir/etc/init.d/xiaomi-chopin-bluetooth"
	install -Dm644 "$srcdir/xiaomi-chopin-iwd.conf" "$pkgdir/etc/conf.d/iwd"
	install -Dm644 "$srcdir/xiaomi-chopin-graphics.sh" \
		"$pkgdir/etc/profile.d/25xiaomi-chopin-graphics.sh"
	install -Dm644 "$srcdir/xiaomi-chopin-video.sh" \
		"$pkgdir/etc/profile.d/25xiaomi-chopin-video.sh"
	install -Dm644 "$srcdir/phoc.ini" "$pkgdir/etc/phosh/phoc.ini"
	install -Dm755 xiaomi-chopin-charging \
		"$pkgdir/usr/libexec/xiaomi-chopin-charging"
	install -Dm755 "$srcdir/xiaomi-chopin-charging.initd" \
		"$pkgdir/etc/init.d/xiaomi-chopin-charging"
	install -Dm644 "$srcdir/xiaomi-chopin-charging.conf" \
		"$pkgdir/etc/conf.d/xiaomi-chopin-charging"
	install -Dm755 "$srcdir/xiaomi-chopin-audio.initd" \
		"$pkgdir/etc/init.d/xiaomi-chopin-audio"
	install -Dm755 "$srcdir/xiaomi-chopin-power.initd" \
		"$pkgdir/etc/init.d/xiaomi-chopin-power"
	install -Dm755 "$srcdir/xiaomi-chopin-power.sleep" \
		"$pkgdir/usr/libexec/elogind/system-sleep/xiaomi-chopin-power"
	install -Dm644 "$srcdir/xiaomi-chopin-suspend.conf" \
		"$pkgdir/usr/lib/elogind/sleep.conf.d/50-xiaomi-chopin.conf"
	install -Dm644 "$srcdir/51-xiaomi-chopin-sensors.gschema.override" \
		"$pkgdir/usr/share/glib-2.0/schemas/51-xiaomi-chopin-sensors.gschema.override"
	install -Dm755 xiaomi-chopin-sensors "$pkgdir/usr/libexec/xiaomi-chopin-sensors"
	install -Dm755 "$srcdir/xiaomi-chopin-sensors.initd" \
		"$pkgdir/etc/init.d/xiaomi-chopin-sensors"
	install -Dm644 "$srcdir/chopin.conf" \
		"$pkgdir/usr/share/alsa/ucm2/MediaTek/chopin/chopin.conf"
	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/MediaTek/chopin/HiFi.conf"
	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/mt6885-mt6359"
	ln -s ../../MediaTek/chopin/chopin.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/mt6885-mt6359/mt6885-mt6359.conf"
	install -Dm644 "$srcdir/51-xiaomi-chopin-audio.conf" \
		"$pkgdir/usr/share/wireplumber/wireplumber.conf.d/51-xiaomi-chopin-audio.conf"
	install -Dm755 xiaomi-chopin-android "$pkgdir/usr/libexec/xiaomi-chopin-android"
	install -Dm755 "$srcdir/xiaomi-chopin-android-run" \
		"$pkgdir/usr/libexec/xiaomi-chopin-android-run"
	install -Dm755 xiaomi-chopin-gnss "$pkgdir/usr/libexec/xiaomi-chopin-gnss"
	local service
	for service in stock vpud dnsproxyd mnld gnss; do
		install -Dm755 "$srcdir/xiaomi-chopin-$service.initd" \
			"$pkgdir/etc/init.d/xiaomi-chopin-$service"
	done
	install -Dm644 "$srcdir/60-xiaomi-chopin-android.rules" \
		"$pkgdir/usr/lib/udev/rules.d/60-xiaomi-chopin-android.rules"
	install -Dm644 "$srcdir/90-xiaomi-chopin-gnss.conf" \
		"$pkgdir/etc/geoclue/conf.d/90-xiaomi-chopin-gnss.conf"
}


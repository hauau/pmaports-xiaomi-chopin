# Reference: <https://postmarketos.org/devicepkg>
maintainer="Sergei Shikalov <ssh@42px.org>"
pkgname=device-xiaomi-chopin
pkgver=1
pkgrel=42
pkgdesc="Redmi Note 10 Pro 5G / POCO X3 GT"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	android-tools-avbtool
	android-tools-mkbootimg
	alsa-ucm-conf
	alsa-utils
	bluez-btmgmt
	bubblewrap
	device-mapper
	geoclue
	iio-sensor-proxy>=3.9-r3
	iio-sensor-proxy-openrc>=3.9-r3
	iio-sensor-proxy-udev>=3.9-r3
	linux-xiaomi-chopin>=4.14.336-r26
	mesa-panfork-chopin>=23.0.0_git20240119-r12
	mount
	firmware-xiaomi-chopin>=20240528-r2
	postmarketos-base
	phoc>=0.57.0-r3
	pipewire>=1.6.9-r1
	polkit-elogind>=127-r4
	polkit-openrc>=127-r4
	util-linux-misc
	"
makedepends_build="devicepkg-dev"
makedepends_host="linux-headers musl-dev"
install="$pkgname.pre-install $pkgname.pre-upgrade $pkgname.post-install $pkgname.post-upgrade"
replaces="iwd-openrc"
replaces_priority=100
source="
	deviceinfo
	xiaomi-chopin-bootimg.sh
	xiaomi-chopin-wifi.c
	xiaomi-chopin-wifi.initd
	xiaomi-chopin-bluetooth.initd
	xiaomi-chopin-iwd.conf
	xiaomi-chopin-graphics.sh
	xiaomi-chopin-video.sh
	phoc.ini
	xiaomi-chopin-charging.c
	xiaomi-chopin-charging.initd
